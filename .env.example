# Secrets — never commit your real .env
OPENAI_API_KEY=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# Admin / human contact
AUTHORIZED_NUMBER=
AUTHORIZED_NUMBERS=
AUTHORIZED_NAMES=admin
HUMAN_WHATSAPP=

# Business overrides
BUSINESS_NAME=Complejo Deportivo CANCHERIA
AGENT_NAME=Cancheria
HUMAN_CONTACT_NAME=Encargado
HUMAN_AVAILABLE_HOURS=Horario a configurar
BUSINESS_ADDRESS=Direccion a configurar
PAYMENT_ALIAS=ALIAS.A.CONFIGURAR
LOCAL_TIMEZONE=America/Argentina/Cordoba
OPENAI_MODEL=gpt-4o-mini

